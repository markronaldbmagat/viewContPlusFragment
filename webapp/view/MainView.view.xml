<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:sap.ui.layout.form="sap.ui.layout.form" xmlns:sap.ui.core="sap.ui.core" controllerName="com.training.exer1.controller.MainView">

    <Page id="page" title="{i18n>title}">

    <content>

        <VBox id="idVbox" class="sapuiSmallMargin">

        <items>

            <sap.ui.layout.form:SimpleForm editable="true" layout="ResponsiveGridLayout" id="form0" title="Details" labelSpanXL="3" labelSpanL="4" emptySpanL="4" emptySpanM="4" emptySpanS="0" columnsXL="1" columnsL="1" columnsM="1" singleContainerFullSize="true">
                
                <sap.ui.layout.form:content>

                    <Label text="First Name" id="idLblFName"/>

                    <Input width="100%" id="idInptFName"/>

                    <Label text="Last Name" id="idLblLName"/>

                    <Input width="100%" id="idInptLName"/>

                    <Label text="Mode of Payment" width="100%" id="idLblMOP"/>

                    <ComboBox id="idSelMOP" change="onChangeMOP">

                        <items>

                            <sap.ui.core:Item key="COD" text="Cash on Delivery" id="idItmCOD"/>

                            <sap.ui.core:Item key="CC" text="Credit Card" id="idItmCC"/>

                            <sap.ui.core:Item text="GCash" id="idItmGCash" key="GCASH"/>

                            </items>
                    </ComboBox>

                    <Label text="Mobile Number" id="idLblPhone" visible="false"/>
                    <Input id="idInputPhone" visible="false"/>
                </sap.ui.layout.form:content>   
            </sap.ui.layout.form:SimpleForm>

        </items>

        </VBox>
        <sap.ui.core:Fragment fragmentName="com.training.exer1.fragment.ShoppingCart" type="XML" />
    </content>

    <footer>

        <Toolbar width="100%" id="toolbar1">

            <content>

                <OverflowToolbar width="100%" id="idOFTFooter">

                    <content>

                        <ToolbarSpacer id="idTSpacerFooter"/>
                        <Button text="Add to Cart" id="idBtnAddToCart" icon="sap-icon://cart" tooltip="Check Out" press="onAddItem"/>
                        <Button text="Check Out" id="idBtnCheckout" icon="sap-icon://cart" tooltip="Check Out" press="onPressCheckout"/> <!--sa step 11, press="onAddItem" ito-->
                        
                    </content>

                </OverflowToolbar>

            </content>

        </Toolbar>

    </footer>

    </Page>
</mvc:View>